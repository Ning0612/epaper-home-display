# Pi Zero 2 W WebUI endpoint
PI_URL=http://192.168.x.x:8000

# Optional: absolute paths if CLIs are not in PATH for scheduled tasks
# CODEX_CMD=codex
# CLAUDE_CMD=claude

# TUI startup wait in ms (increase if CLI is slow to load)
TUI_STARTUP_MS=1500

# TUI total wait in ms (increase on slow machines)
TUI_WAIT_MS=9000
